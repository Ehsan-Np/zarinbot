APP_NAME="زرین بوت (ZarinBot)"
APP_ENV=production
APP_KEY=base64:zarinbot_secret_aes_256_encryption_key_2026_production=
APP_DEBUG=false
APP_URL=https://zarinbot.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# دیتابیس درون‌برنامه‌ای (Embedded SQLite / MySQL)
DB_CONNECTION=sqlite
DB_DATABASE=/home/user/ZarinBot_Laravel/database/database.sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# درگاه زرین‌پال و پیامک کاوه‌نگار
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=false
KAVENEGAR_API_KEY=YOUR_KAVENEGAR_API_KEY

# موتور رفع فیلترینگ زرین بوت
DOH_RESOLVER_URL=https://1.1.1.1/dns-query
ENABLE_TLS_FRAGMENTATION=true
ANTIFILTER_SYNC_ENABLED=true
