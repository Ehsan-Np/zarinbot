{
    "name": "zarinbot/laravel13-saas",
    "type": "project",
    "description": "ZarinBot (زرین بوت) - Iranian Instagram & WhatsApp Automation SaaS Platform with Anti-Censorship Engine in Laravel 13",
    "keywords": ["laravel13", "zarinbot", "instagram-automation", "whatsapp-automation", "anti-censorship", "doh", "iran"],
    "license": "proprietary",
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "guzzlehttp/guzzle": "^7.8",
        "maatwebsite/excel": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
